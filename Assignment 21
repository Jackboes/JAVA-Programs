import java.sql.*;

public class Assigment21 {
    public static void main(String[] args) {
        try {
            Class.forName("com.mysql.cj.jdbc.Driver");
            System.out.println("Driver loaded.");

            Connection con = DriverManager.getConnection(
                    DBConnection.URL, DBConnection.USER, DBConnection.PASS);

            if (con != null && !con.isClosed()) {
                System.out.println("Connection Status: CONNECTED");
                System.out.println("Database Product : " + con.getMetaData().getDatabaseProductName());
                System.out.println("URL              : " + con.getMetaData().getURL());
            }

            System.out.println("\nStudent database (" + con.getCatalog() + ") is connected successfully.");

            Statement st = con.createStatement();
            ResultSet rs = st.executeQuery("SELECT COUNT(*) FROM student");
            if (rs.next()) System.out.println("Total students in table: " + rs.getInt(1));

            rs.close();
            st.close();
            con.close();
            System.out.println("Connection closed.");
        } catch (ClassNotFoundException e) {
            System.out.println("Driver not found - add MySQL connector jar to the project.");
        } catch (SQLException e) {
            System.out.println("Connection Status: FAILED - " + e.getMessage());
        }
    }
}
